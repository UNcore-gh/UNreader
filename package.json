{
  "name": "unreader",
  "version": "0.2.7",
  "description": "UNreader - A beautiful, fully offline e-book reader. EPUB first, plus MOBI/AZW3 and TXT.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "lint": "eslint .",
    "deploy": "node scripts/deploy.mjs",
    "release": "node scripts/release-sync.mjs patch",
    "release:minor": "node scripts/release-sync.mjs minor",
    "release:major": "node scripts/release-sync.mjs major",
    "release:sync": "node scripts/release-sync.mjs none",
    "test:engine": "esbuild test/harness.ts --bundle --outfile=test/bundle.js --format=esm --target=es2022 --alias:obsidian=./test/obsidian-stub.mjs --external:./pdf.js --log-level=warning",
    "test:reload": "esbuild test/reload-entry.ts --bundle --outfile=test/reload-bundle.js --format=esm --target=es2022 --alias:obsidian=./test/obsidian-stub.mjs --external:./pdf.js --log-level=warning",
    "test:mobi": "esbuild test/harness-mobi.ts --bundle --outfile=test/mobi-bundle.js --format=esm --target=es2022 --alias:obsidian=./test/obsidian-stub.mjs --external:./pdf.js --log-level=warning",
    "test:end": "esbuild test/end-probe.ts --bundle --outfile=test/end-bundle.js --format=esm --target=es2022 --alias:obsidian=./test/obsidian-stub.mjs --external:./pdf.js --log-level=warning",
    "test:txt": "esbuild test/txt-probe.ts --bundle --outfile=test/txt-bundle.js --format=esm --target=es2022 --alias:obsidian=./test/obsidian-stub.mjs --external:./pdf.js --log-level=warning && node test/run-txt.mjs",
    "test:swipe": "esbuild test/swipe-probe.ts --bundle --outfile=test/swipe-bundle.js --format=esm --target=es2022 --alias:obsidian=./test/obsidian-stub.mjs --external:./pdf.js --log-level=warning && node test/run-swipe.mjs",
    "test:progress-pos": "node test/run-progress-pos.mjs",
    "test:header-band-real": "node test/run-header-band-real.mjs",
    "test:headerbanddiag": "esbuild test/headerbanddiag-probe.ts --bundle --outfile=test/headerbanddiag-bundle.js --format=iife --target=es2022 --alias:obsidian=./test/obsidian-stub.mjs --log-level=warning && node test/run-headerbanddiag.mjs",
    "test:toc-rail": "node test/run-toc-rail.mjs",
    "test:toc-hover": "esbuild test/toc-hover-probe.ts --bundle --outfile=test/toc-hover-bundle.js --format=esm --target=es2022 --alias:obsidian=./test/obsidian-stub-nav.mjs --external:./pdf.js --log-level=warning && node test/run-toc-hover.mjs",
    "test:chrome-motion": "esbuild test/chrome-motion-probe.ts --bundle --outfile=test/chrome-motion-bundle.js --format=esm --target=es2022 --alias:obsidian=./test/obsidian-stub-anno.mjs --external:./pdf.js --log-level=warning && node test/run-chrome-motion.mjs",
    "test:tocjump": "esbuild test/tocjump-probe.ts --bundle --outfile=test/tocjump-bundle.js --format=esm --target=es2022 --alias:obsidian=./test/obsidian-stub.mjs --external:./pdf.js --log-level=warning && node test/run-tocjump.mjs",
    "test:toc-cmd-chrome": "esbuild test/toc-command-chrome-probe.ts --bundle --outfile=test/toc-command-chrome-bundle.js --format=esm --target=es2022 --alias:obsidian=./test/obsidian-stub-nav.mjs --external:./pdf.js --log-level=warning && node test/run-toc-command-chrome.mjs",
    "test:pagenum": "esbuild test/pagenum-probe.ts --bundle --outfile=test/pagenum-bundle.js --format=esm --target=es2022 --alias:obsidian=./test/obsidian-stub-nav.mjs --log-level=warning && node test/run-pagenum.mjs",
    "test:pagealign": "esbuild test/pagealign-probe.ts --bundle --outfile=test/pagealign-bundle.js --format=esm --target=es2022 --alias:obsidian=./test/obsidian-stub-nav.mjs --log-level=warning && node test/run-pagealign.mjs",
    "test:taproute": "esbuild test/taproute-probe.ts --bundle --outfile=test/taproute-bundle.js --format=esm --target=es2022 --alias:obsidian=./test/obsidian-stub-nav.mjs --external:./pdf.js --log-level=warning && node test/run-taproute.mjs",
    "test:navguard": "esbuild test/navguard-probe.ts --bundle --outfile=test/navguard-bundle.js --format=esm --target=es2022 --alias:obsidian=./test/obsidian-stub-nav.mjs --external:./pdf.js --log-level=warning && node test/run-navguard.mjs",
    "test:bottom-band": "node test/run-bottom-band.mjs",
    "test:top-band": "node test/run-top-band.mjs",
    "test:immersive-adapt": "esbuild test/immersive-adapt-probe.ts --bundle --outfile=test/immersive-adapt-bundle.js --format=esm --target=es2022 --log-level=warning && node test/run-immersive-adapt.mjs",
    "test:scrolldir": "esbuild test/scrolldir-probe.ts --bundle --outfile=test/scrolldir-bundle.js --format=esm --target=es2022 --alias:obsidian=./test/obsidian-stub.mjs --external:./pdf.js --log-level=warning && node test/run-scrolldir.mjs",
    "test:restore-open": "esbuild test/restore-open-probe.ts --bundle --outfile=test/restore-open-bundle.js --format=esm --target=es2022 --alias:obsidian=./test/obsidian-stub.mjs --external:./pdf.js --log-level=warning && node test/run-restore-open.mjs",
    "test:readwidth": "node test/run-readwidth.mjs",
    "test:comment-mobile": "esbuild test/comment-mobile-probe.ts --bundle --outfile=test/comment-mobile-bundle.js --format=esm --target=es2022 --alias:obsidian=./test/obsidian-stub-anno.mjs --external:./pdf.js --log-level=warning && node test/run-comment-mobile.mjs",
    "test:modal-kb": "node test/run-modal-kb.mjs",
    "test:focusgate": "esbuild test/focus-gate-probe.ts --bundle --outfile=test/focus-gate-bundle.js --format=esm --target=es2022 --alias:obsidian=./test/obsidian-stub.mjs --external:./pdf.js --log-level=warning && node test/run-focusgate.mjs",
    "test:rail-active": "esbuild test/rail-active-probe.ts --bundle --outfile=test/rail-active-bundle.js --format=esm --target=es2022 --alias:obsidian=./test/obsidian-stub-anno.mjs --external:./pdf.js --log-level=warning && node test/run-rail-active.mjs",
    "test:openperf": "esbuild test/openperf-entry.ts --bundle --outfile=test/openperf-bundle.js --format=esm --target=es2022 --alias:obsidian=./test/obsidian-stub.mjs --external:./pdf.js --log-level=warning && node test/run-openperf.mjs",
    "test:font": "esbuild test/font-panel-probe.ts --bundle --outfile=test/font-panel-bundle.js --format=esm --target=es2022 --alias:obsidian=./test/obsidian-stub-anno.mjs --external:./pdf.js --log-level=warning && node test/run-font-panel.mjs",
    "test:font-io": "node test/run-font-io.mjs",
    "test:library-heal": "node test/run-library-heal.mjs",
    "test:progress-durability": "node test/run-progress-durability.mjs",
    "test:exclusions": "node test/run-exclusions.mjs",
    "test:gap": "esbuild test/gap-probe.ts --bundle --outfile=test/gap-bundle.js --format=esm --target=es2022 --alias:obsidian=./test/obsidian-stub.mjs --external:./pdf.js --log-level=warning && node test/run-gap.mjs",
    "test:csseq": "node test/run-csseq.mjs",
    "test:reclaim": "node test/run-reclaim.mjs",
    "test:startup-layout": "node test/run-startup-layout.mjs",
    "perf:startup": "node .perf/runner.cjs --runs=11 --phases=parse,moduleLoad,onload,layout --label=startup",
    "perf:open": "esbuild test/openperf-entry.ts --bundle --outfile=test/openperf-bundle.js --format=esm --target=es2022 --alias:obsidian=./test/obsidian-stub.mjs --external:./pdf.js --log-level=warning && node test/run-openperf.mjs"
  },
  "keywords": [],
  "author": "UNcore",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.17",
    "builtin-modules": "^4.0.0",
    "esbuild": "0.25.5",
    "eslint": "^10.10.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "obsidian": "latest",
    "playwright-core": "^1.63.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0"
  }
}
